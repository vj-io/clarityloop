# Supabase project URL (public; read by the browser client)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key (public; read by the browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only; bypasses RLS; never give it a NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=
# Direct, non-pooling Postgres connection string (server only; used by npm run db:apply)
POSTGRES_URL_NON_POOLING=
# Nexconn App Key (also returned to the browser by /api/config; public by design)
NEXCONN_APP_KEY=
# Nexconn App Secret (server only)
NEXCONN_APP_SECRET=
# Nexconn data center area: SG, NA or SA; default SG; must match the area chosen in the Nexconn Console
NEXCONN_AREA=
# AI Gateway model id for translation and extraction; default google/gemini-3.5-flash-lite
AI_MODEL=
# Optional: comma-separated models tried in order when the first is out of quota or overloaded
AI_FALLBACK_MODELS=
# Google AI Studio key (optional): when set, google/... models are called directly, no gateway needed
GOOGLE_GENERATIVE_AI_API_KEY=
# AI Gateway API key (optional; on Vercel the project OIDC token is used instead)
AI_GATEWAY_API_KEY=
# Optional: pause in ms between model calls in scripts/eval.mjs
EVAL_GAP_MS=
